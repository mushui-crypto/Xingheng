{
  "name": "xingheng-tradesim-mvp",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && npm run build:api && vite build",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.js",
    "deploy:validate": "node scripts/validate-deploy.mjs",
    "verify:production-safety": "tsx scripts/verify-production-wallet.ts && node scripts/verify-production-config.mjs && node scripts/verify-restore.mjs",
    "preview": "vite preview",
    "start:api": "node dist-server/index.js",
    "test:hyperliquid-precision": "tsx --test server/modules/hyperliquid/hyperliquidPrecision.test.ts",
    "test:strategy": "tsx --test server/modules/strategy/**/*.test.ts",
    "backtest:ict:btc": "tsx scripts/backtest-ict-btc.ts",
    "backtest:ict:binance": "tsx scripts/backtest-ict-binance.ts",
    "research:ict:grid": "tsx scripts/research-ict-grid.ts",
    "research:ict:combine": "tsx scripts/combine-ict-research-years.ts",
    "research:ict:validate": "tsx scripts/validate-ict-candidate.ts",
    "research:ict:validate:v2": "tsx scripts/validate-ict-candidate-v2.ts",
    "backtest:ict:v4:ytd": "tsx scripts/backtest-ict-v4-ytd.ts 2026-07-13 v4",
    "backtest:ict:ytd": "tsx scripts/backtest-ict-v4-ytd.ts",
    "research:ict:leverage100x": "tsx scripts/backtest-ict-leverage-route.ts",
    "research:ict:forward": "tsx scripts/forward-ict-binance.ts",
    "research:ict:history": "tsx scripts/generate-ict-history-report.ts",
    "verify:hyperliquid-testnet-precision": "tsx scripts/verify-hyperliquid-testnet-precision.ts"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "^0.33.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^9.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "ws": "^8.21.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vite": "^8.0.16"
  }
}
