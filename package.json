    "research:ict:history": "tsx scripts/generate-ict-history-report.ts",
    "strategy:history:check": "node scripts/check-strategy-history-report.mjs",
    "research:ict:route-a": "tsx scripts/research-ict-route-a-trend-pullback.ts",
    "research:ict:btc:entry-expansion": "tsx scripts/research-btc-entry-expansion-v2.ts",
