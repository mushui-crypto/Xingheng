# Copy to .env.real-test on the server. Never reuse .env.production or its secrets.
# The same file is used by exactly one selected topology:
# - shared: scripts/real-test-compose.sh (no host ports)
# - standalone: scripts/real-test-standalone-compose.sh (fixed 80/443)
# Never run both wrappers for the same xingheng-real-test project.
XINGHENG_REVISION=REPLACE_WITH_FULL_GIT_COMMIT
REAL_TEST_DOMAIN=replace-real-test.example.invalid
APP_PUBLIC_URL=https://replace-real-test.example.invalid
CORS_ALLOWED_ORIGINS=https://replace-real-test.example.invalid

ADMIN_EMAIL=replace-real-test@example.invalid
ADMIN_PASSWORD=REPLACE_WITH_INDEPENDENT_LONG_RANDOM_SECRET
USER_SESSION_TTL_HOURS=24
ADMIN_SESSION_TTL_HOURS=8
AUTH_RATE_LIMIT_MAX=10

SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_INDEPENDENT_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_INDEPENDENT_SMTP_PASSWORD
SMTP_FROM="Stella X Real Test <no-reply@replace-real-test.example.invalid>"

HYPERLIQUID_REST_BASE_URL=https://api.hyperliquid.xyz
HYPERLIQUID_STREAM_URL=wss://api.hyperliquid.xyz/ws
REAL_TRADING_EXCHANGE_RATE_LIMIT_MAX=30
REAL_TRADING_RISK_MAX_SNAPSHOT_AGE_MS=10000
REAL_TRADING_AUDIT_RETENTION_DAYS=180
REAL_TRADING_REALTIME_TOKEN_TTL_MS=60000
REAL_TRADING_REALTIME_MAX_ADDRESSES=100
REAL_TRADING_RECONCILIATION_INTERVAL_MS=60000
REAL_TRADING_RECONCILIATION_BATCH_SIZE=50

RWA_CREDENTIAL_KEY_PROVIDER=gcp-kms
RWA_GCP_KMS_AUTH_MODE=gce_attached_service_account
# Must be a dedicated real-test CryptoKey and must differ from production.
RWA_GCP_KMS_KEY_NAME=projects/xingheng-real-test/locations/asia-southeast1/keyRings/xingheng-rwa-real-test-sg/cryptoKeys/exchange-credentials
# Non-secret exact identity attached to the dedicated real-test GCE VM. Service-account key files are forbidden.
RWA_GCE_EXPECTED_SERVICE_ACCOUNT_EMAIL=REPLACE_WITH_ATTACHED_VM_SERVICE_ACCOUNT@xingheng-real-test.iam.gserviceaccount.com
RWA_AUTOMATION_DATA_DIR=/app/rwa-automation-data
RWA_AUTOMATION_INSTANCE_COUNT=1
WEB_CONCURRENCY=1
RWA_AUTOMATION_EXECUTION_MODE=single-host
RWA_AUTOMATION_LOCK_DIR=/app/rwa-automation-lock
RWA_AUTOMATION_LOCK_PATH=/app/rwa-automation-lock/operation.lock
RWA_AUTOMATION_SERVER_KILL_SWITCH=true
RWA_AUTOMATION_BACKUP_DIR=/app/rwa-automation-backups
RWA_AUTOMATION_BACKUP_RETENTION_DAYS=30
RWA_AUTOMATION_BACKUP_MAX_TOTAL_BYTES=1073741824
RWA_AUTOMATION_BACKUP_MAX_SNAPSHOT_BYTES=104857600
RWA_AUTOMATION_CREDENTIAL_RATE_MAX=4
RWA_AUTOMATION_CREDENTIAL_RATE_WINDOW_SECONDS=600
RWA_AUTOMATION_RISK_CONTROL_RATE_MAX=6
RWA_AUTOMATION_RISK_CONTROL_RATE_WINDOW_SECONDS=600
RWA_AUTOMATION_PREFLIGHT_BURST_MAX=4
RWA_AUTOMATION_PREFLIGHT_BURST_WINDOW_SECONDS=10
RWA_AUTOMATION_PREFLIGHT_SUSTAINED_MAX=30
RWA_AUTOMATION_PREFLIGHT_SUSTAINED_WINDOW_SECONDS=600
RWA_AUTOMATION_EXECUTE_BURST_MAX=2
RWA_AUTOMATION_EXECUTE_BURST_WINDOW_SECONDS=60
RWA_AUTOMATION_EXECUTE_SUSTAINED_MAX=6
RWA_AUTOMATION_EXECUTE_SUSTAINED_WINDOW_SECONDS=3600
RWA_AUTOMATION_EXECUTE_CONCURRENCY=1
RWA_AUTOMATION_EXIT_OPERATION_MAX=8
RWA_AUTOMATION_EXIT_OPERATION_WINDOW_SECONDS=60
RWA_AUTOMATION_EXIT_SHARED_MAX=12
RWA_AUTOMATION_EXIT_SHARED_WINDOW_SECONDS=60
RWA_AUTOMATION_EXIT_RESERVE_MAX=3
RWA_AUTOMATION_EXIT_RESERVE_WINDOW_SECONDS=3600
RWA_AUTOMATION_EXIT_CONCURRENCY=1
RWA_AUTOMATION_MAX_IN_FLIGHT=1000
RWA_AUTOMATION_MAX_IN_FLIGHT_PER_USER=10
RWA_AUTOMATION_PRIVATE_READ_MAX=120
RWA_AUTOMATION_PRIVATE_READ_WINDOW_SECONDS=60
RWA_AUTOMATION_MAX_RATE_BUCKETS=20000
RWA_AUTOMATION_MAX_RATE_BUCKETS_PER_USER=200
RWA_AUTOMATION_MAX_GOVERNANCE_AUDIT=5000
RWA_AUTOMATION_MAX_GOVERNANCE_AUDIT_PER_USER=100
RWA_AUTOMATION_CHALLENGE_TTL_SECONDS=60
RWA_AUTOMATION_MAX_CHALLENGES=5000
RWA_AUTOMATION_MAX_CHALLENGES_PER_USER=20
RWA_AUTOMATION_MAX_USER_REGISTRIES=1000
RWA_AUTOMATION_REGISTRY_IDLE_TTL_SECONDS=1800
RWA_AUTOMATION_MAX_STEP_UP_AUTHORIZATIONS=10000
RWA_AUTOMATION_MAX_STEP_UP_AUTHORIZATIONS_PER_USER=20
RWA_AUTOMATION_MAX_STEP_UP_ATTEMPTS=20000
RWA_AUTOMATION_MAX_STEP_UP_ATTEMPTS_PER_USER=100
RWA_AUTOMATION_MAX_STEP_UP_STORES=1000
RWA_AUTOMATION_IDEMPOTENCY_RETENTION_SECONDS=2592000
RWA_AUTOMATION_MAX_COMPLETED_EXECUTIONS=2000
RWA_AUTOMATION_MAX_COMPLETED_EXECUTIONS_HARD=2200
RWA_AUTOMATION_MAX_ACTIVE_EXECUTIONS=100
RWA_AUTOMATION_MAX_PNL_POINTS=1000
RWA_AUTOMATION_MAX_CREDENTIAL_AUDIT=500
RWA_AUTOMATION_STATE_MAX_BYTES=8388608
RWA_AUTOMATION_STATE_MAX_BYTES_HARD=10485760
RWA_BINANCE_ALLOWED_EGRESS_IPS=
# Must be empty until a dedicated real-test Binance account/key is configured.
# Any value overlapping .env.production is rejected by dual-topology validation.
RWA_AUTOMATION_MONITORED_BINANCE_ACCOUNT_IDS=
# Must resolve to the real-test credential owner; never copy the production value by assumption.
RWA_PROVIDER_PREFLIGHT_USER_ID=

STRATEGY_FORWARD_REPORT_PATH=/app/strategy-data/route-b-forward.json
STRATEGY_HISTORY_REPORT_PATH=/app/strategy-data/route-b-history.json
STRATEGY_FORWARD_WORKER_ENABLED=true
STRATEGY_FORWARD_WORKER_POLL_MS=300000
MARTINGALE_GRID_PAPER_REPORT_PATH=/app/strategy-data/martingale-grid-paper.json
MARTINGALE_GRID_PAPER_WORKER_ENABLED=true
MARTINGALE_GRID_PAPER_WORKER_POLL_MS=300000
FIXED_GRID_PAPER_REPORT_PATH=/app/strategy-data/fixed-grid-paper.json
FIXED_GRID_ARCHIVE_CACHE_PATH=/app/strategy-data/fixed-grid-archive-cache
FIXED_GRID_PAPER_WORKER_ENABLED=true
FIXED_GRID_PAPER_WORKER_POLL_MS=300000
STRATEGY_EMAIL_ALERTS_ENABLED=false
STRATEGY_ALERT_EMAIL_TO=ops-real-test@example.invalid
STRATEGY_ALERT_COOLDOWN_MS=900000

BSC_TESTNET_CHAIN_ID=97
BSC_TESTNET_RPC_URL=REPLACE_WITH_BSC_TESTNET_RPC_URL
BSC_TESTNET_TOKEN_ADDRESS=REPLACE_WITH_BSC_TESTNET_TOKEN_ADDRESS
BSC_TESTNET_TOKEN_DECIMALS=18
BSC_TESTNET_CONFIRMATIONS=1
BSC_TESTNET_SCAN_START_BLOCK=0
BSC_TESTNET_SCAN_BATCH_SIZE=1
BSC_TESTNET_DERIVATION_PATH=m/44'/60'/0'/0
BSC_TESTNET_PRIVATE_KEY=
BSC_TESTNET_DEPOSIT_MNEMONIC=
BACKUP_RETENTION_DAYS=14
