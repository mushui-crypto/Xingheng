# Copy to .env.production on the server. Never commit the populated file.
DOMAIN=replace-me.example.invalid
APP_PUBLIC_URL=https://replace-me.example.invalid
# Exact HTTPS origins only, comma-separated if operationally required. No path or trailing slash.
CORS_ALLOWED_ORIGINS=https://replace-me.example.invalid

ADMIN_EMAIL=replace-me@example.invalid
# Generate a long random value (at least 12 characters); do not reuse a personal password.
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET

# API/session controls
USER_SESSION_TTL_HOURS=24
ADMIN_SESSION_TTL_HOURS=8
AUTH_RATE_LIMIT_MAX=10

# SMTP is required for registration verification and password reset.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="Stella X <no-reply@replace-me.example.invalid>"

# Hyperliquid public market-data endpoints
HYPERLIQUID_REST_BASE_URL=https://api.hyperliquid.xyz
HYPERLIQUID_STREAM_URL=wss://api.hyperliquid.xyz/ws

# Hyperliquid Testnet real-trading guardrails. No API-wallet secret belongs in server configuration.
REAL_TRADING_EXCHANGE_RATE_LIMIT_MAX=30
# Account and market snapshots older than this are not trusted for new-risk orders.
REAL_TRADING_RISK_MAX_SNAPSHOT_AGE_MS=10000
REAL_TRADING_AUDIT_RETENTION_DAYS=180
REAL_TRADING_REALTIME_TOKEN_TTL_MS=60000
REAL_TRADING_REALTIME_MAX_ADDRESSES=100
# Pending reconciliation worker only queries Hyperliquid orderStatus; it never replays signed orders.
REAL_TRADING_RECONCILIATION_INTERVAL_MS=60000
REAL_TRADING_RECONCILIATION_BATCH_SIZE=50

# RWA Mainnet automation remains fail-closed until a controlled execution window.
RWA_AUTOMATION_MASTER_KEY=
RWA_AUTOMATION_DATA_DIR=/app/rwa-automation-data
RWA_AUTOMATION_SERVER_KILL_SWITCH=true
# Required for Binance real execution. Exact comma-separated public IPv4 values only; no wildcard/CIDR.
# This set must exactly match the Binance API Key ipList or all new-risk actions fail closed.
RWA_BINANCE_ALLOWED_EGRESS_IPS=

# Strategy Paper operations. Compose also pins the two report paths to the dedicated strategy_data volume.
STRATEGY_FORWARD_REPORT_PATH=/app/strategy-data/route-b-forward.json
STRATEGY_HISTORY_REPORT_PATH=/app/strategy-data/route-b-history.json
STRATEGY_FORWARD_WORKER_ENABLED=true
STRATEGY_FORWARD_WORKER_POLL_MS=300000
MARTINGALE_GRID_PAPER_REPORT_PATH=/app/strategy-data/martingale-grid-paper.json
MARTINGALE_GRID_PAPER_WORKER_ENABLED=true
MARTINGALE_GRID_PAPER_WORKER_POLL_MS=300000
FIXED_GRID_PAPER_REPORT_PATH=/app/strategy-data/fixed-grid-paper.json
FIXED_GRID_ARCHIVE_CACHE_PATH=/app/strategy-data/fixed-grid-archive-cache
FIXED_GRID_PAPER_WORKER_ENABLED=true
FIXED_GRID_PAPER_WORKER_POLL_MS=300000
STRATEGY_EMAIL_ALERTS_ENABLED=false
STRATEGY_ALERT_EMAIL_TO=ops@example.invalid
STRATEGY_ALERT_COOLDOWN_MS=900000

# Fixed product boundary: BSC Testnet only. Chain ID is also pinned to 97 by Compose/API validation.
BSC_TESTNET_CHAIN_ID=97
# Intentionally invalid placeholders: production startup rejects both until replaced.
BSC_TESTNET_RPC_URL=REPLACE_WITH_BSC_TESTNET_RPC_URL
BSC_TESTNET_TOKEN_ADDRESS=REPLACE_WITH_BSC_TESTNET_TOKEN_ADDRESS
BSC_TESTNET_TOKEN_DECIMALS=18
BSC_TESTNET_CONFIRMATIONS=1
BSC_TESTNET_SCAN_START_BLOCK=0
BSC_TESTNET_SCAN_BATCH_SIZE=1
BSC_TESTNET_DERIVATION_PATH=m/44'/60'/0'/0

# Optional until the corresponding BSC Testnet operation is intentionally enabled.
# Store populated secrets outside Git and restrict this file to chmod 600.
BSC_TESTNET_PRIVATE_KEY=
BSC_TESTNET_DEPOSIT_MNEMONIC=

# Backup retention used by scripts/backup.sh.
BACKUP_RETENTION_DAYS=14
