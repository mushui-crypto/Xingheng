NODE_ENV=development
API_PORT=8787
# Production cross-check only: must equal the revision in the trusted release manifest.
# XINGHENG_REVISION=REPLACE_WITH_FULL_GIT_COMMIT

# Required before enabling the admin console. ADMIN_PASSWORD must be at least 12 characters.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-long-random-secret

# Session and request protection.
# USER_SESSION_TTL_HOURS=24
# ADMIN_SESSION_TTL_HOURS=8
# AUTH_RATE_LIMIT_MAX=10
# CORS_ALLOWED_ORIGINS=https://your-domain.example
# Public origin used in email links. Defaults to http://localhost:5173 outside production.
# APP_PUBLIC_URL=http://localhost:5173
# Set to true only when the API is behind one trusted reverse proxy.
# TRUST_PROXY=false

# SMTP is required in production for registration and password reset verification emails.
# In development, missing SMTP prints verification codes to the API log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM="Stella X <no-reply@example.com>"

# The demo user can only be enabled outside production and is disabled automatically in production.
# SEED_DEMO_USER_ENABLED=true
# SEED_DEMO_USER_PASSWORD=demo123

# Hyperliquid public mainnet market-data endpoints.
# HYPERLIQUID_REST_BASE_URL=https://api.hyperliquid.xyz
# HYPERLIQUID_STREAM_URL=wss://api.hyperliquid.xyz/ws

# Hyperliquid Testnet real-trading guardrails. The server never accepts or stores an API-wallet private key.
# REAL_TRADING_EXCHANGE_RATE_LIMIT_MAX=30
# Account and market snapshots older than this are not trusted for new-risk orders.
# REAL_TRADING_RISK_MAX_SNAPSHOT_AGE_MS=10000
# REAL_TRADING_AUDIT_RETENTION_DAYS=180
# REAL_TRADING_REALTIME_TOKEN_TTL_MS=60000
# REAL_TRADING_REALTIME_MAX_ADDRESSES=100
# Pending reconciliation worker only queries Hyperliquid orderStatus; it never replays signed orders.
# REAL_TRADING_RECONCILIATION_INTERVAL_MS=60000
# REAL_TRADING_RECONCILIATION_BATCH_SIZE=50

# RWA Mainnet automation uses GCP KMS envelope V2. Local master keys and service-account JSON keys are rejected.
# RWA_CREDENTIAL_KEY_PROVIDER=gcp-kms
# RWA_GCP_KMS_KEY_NAME=projects/xingheng-production/locations/asia/keyRings/xingheng-rwa-prod-sg/cryptoKeys/exchange-credentials
# RWA_GCP_WIF_AUDIENCE=//iam.googleapis.com/projects/REPLACE_WITH_PROJECT_NUMBER/locations/global/workloadIdentityPools/REPLACE_WITH_POOL/providers/REPLACE_WITH_PROVIDER
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-wif/adc.json
# Per-user/venue encrypted credential and non-sensitive state directory.
# RWA_AUTOMATION_DATA_DIR=server/data/rwa-automation
# Production is pinned to one Node API process until distributed locking is implemented.
# RWA_AUTOMATION_INSTANCE_COUNT=1
# WEB_CONCURRENCY=1
# RWA_AUTOMATION_EXECUTION_MODE=single-host
# RWA_AUTOMATION_LOCK_DIR=/app/rwa-automation-lock
# RWA_AUTOMATION_LOCK_PATH=/app/rwa-automation-lock/operation.lock
# Defaults to active. Set to false only in an explicitly approved execution window.
# RWA_AUTOMATION_SERVER_KILL_SWITCH=true
# Required before Binance credentials can become active. Comma-separated exact IPv4 values only.
# The configured set must exactly match the Binance API Key ipList; wildcards and CIDR are rejected.
# RWA_BINANCE_ALLOWED_EGRESS_IPS=203.0.113.10,203.0.113.11
# Optional, default empty (Binance activity continuity stays incomplete). Only server-derived dedicated
# subaccount fingerprints are accepted; never place a provider UID, API key, or other credential here.
# RWA_AUTOMATION_MONITORED_BINANCE_ACCOUNT_IDS=binance:0123456789abcdef

# Optional SQLite file path for simulated accounts, orders, positions, and balance adjustments.
# Defaults to server/data/trading.sqlite
# TRADING_DB_PATH=server/data/trading.sqlite

# Strategy Paper reports. Production Compose pins these to /app/strategy-data on a dedicated named volume.
# STRATEGY_FORWARD_REPORT_PATH=server/data/strategy/research-ict-route-b-forward.json
# STRATEGY_HISTORY_REPORT_PATH=server/data/strategy/research-ict-route-b-history.json
# STRATEGY_FORWARD_WORKER_ENABLED=true
# STRATEGY_FORWARD_WORKER_POLL_MS=300000
# MARTINGALE_GRID_PAPER_REPORT_PATH=server/data/strategy/research-martingale-grid-paper.json
# MARTINGALE_GRID_PAPER_WORKER_ENABLED=true
# MARTINGALE_GRID_PAPER_WORKER_POLL_MS=300000
# FIXED_GRID_PAPER_REPORT_PATH=server/data/strategy/research-fixed-grid-paper.json
# FIXED_GRID_ARCHIVE_CACHE_PATH=server/data/strategy/fixed-grid-archive-cache
# FIXED_GRID_PAPER_WORKER_ENABLED=true
# FIXED_GRID_PAPER_WORKER_POLL_MS=300000
# Strategy alert email is disabled by default; enable only after SMTP is configured.
# STRATEGY_EMAIL_ALERTS_ENABLED=false
# STRATEGY_ALERT_EMAIL_TO=ops@example.invalid
# STRATEGY_ALERT_COOLDOWN_MS=900000

# RWA automation disaster recovery. Production paths are fixed by Compose and must not overlap SQLite,
# strategy reports, or WIF identity material.
# RWA_AUTOMATION_DATA_DIR=server/data/rwa-automation
# RWA_AUTOMATION_BACKUP_DIR=server/data/rwa-automation-backups
# RWA_AUTOMATION_BACKUP_RETENTION_DAYS=30
# RWA_AUTOMATION_BACKUP_MAX_TOTAL_BYTES=1073741824
# RWA_AUTOMATION_BACKUP_MAX_SNAPSHOT_BYTES=104857600
# Automation limiter/state governance uses bounded defaults when omitted. Representative overrides:
# RWA_AUTOMATION_PREFLIGHT_BURST_MAX=4
# RWA_AUTOMATION_PREFLIGHT_SUSTAINED_MAX=30
# RWA_AUTOMATION_EXECUTE_BURST_MAX=2
# RWA_AUTOMATION_EXECUTE_SUSTAINED_MAX=6
# RWA_AUTOMATION_EXECUTE_CONCURRENCY=1
# RWA_AUTOMATION_EXIT_SHARED_MAX=12
# RWA_AUTOMATION_EXIT_RESERVE_MAX=3
# RWA_AUTOMATION_EXIT_CONCURRENCY=1
# RWA_AUTOMATION_MAX_IN_FLIGHT=1000
# RWA_AUTOMATION_MAX_IN_FLIGHT_PER_USER=10
# RWA_AUTOMATION_MAX_RATE_BUCKETS=20000
# RWA_AUTOMATION_MAX_RATE_BUCKETS_PER_USER=200
# RWA_AUTOMATION_MAX_CHALLENGES=5000
# RWA_AUTOMATION_MAX_CHALLENGES_PER_USER=20
# RWA_AUTOMATION_MAX_STEP_UP_ATTEMPTS_PER_USER=100
# RWA_AUTOMATION_IDEMPOTENCY_RETENTION_SECONDS=2592000
# RWA_AUTOMATION_MAX_COMPLETED_EXECUTIONS=2000
# RWA_AUTOMATION_MAX_COMPLETED_EXECUTIONS_HARD=2200
# RWA_AUTOMATION_STATE_MAX_BYTES=8388608
# RWA_AUTOMATION_STATE_MAX_BYTES_HARD=10485760

# BSC Testnet only. Keep the private key and mnemonic in a secret manager in production.
# BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# BSC_TESTNET_CHAIN_ID=97
# BSC_TESTNET_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# BSC_TESTNET_TOKEN_DECIMALS=18
# BSC_TESTNET_CONFIRMATIONS=1
# BSC_TESTNET_SCAN_START_BLOCK=0
# BSC_TESTNET_SCAN_BATCH_SIZE=1
# BSC_TESTNET_PRIVATE_KEY=
# BSC_TESTNET_DEPOSIT_MNEMONIC=
# BSC_TESTNET_DERIVATION_PATH=m/44'/60'/0'/0
