NODE_ENV=development
API_PORT=8787

# Required before enabling the admin console. ADMIN_PASSWORD must be at least 12 characters.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-long-random-secret

# Session and request protection.
# USER_SESSION_TTL_HOURS=24
# ADMIN_SESSION_TTL_HOURS=8
# AUTH_RATE_LIMIT_MAX=10
# CORS_ALLOWED_ORIGINS=https://your-domain.example
# Public origin used in email links. Defaults to http://localhost:5173 outside production.
# APP_PUBLIC_URL=http://localhost:5173
# Set to true only when the API is behind one trusted reverse proxy.
# TRUST_PROXY=false

# SMTP is required in production for registration and password reset verification emails.
# In development, missing SMTP prints verification codes to the API log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM="Stella X <no-reply@example.com>"

# The demo user can only be enabled outside production and is disabled automatically in production.
# SEED_DEMO_USER_ENABLED=true
# SEED_DEMO_USER_PASSWORD=demo123

# Hyperliquid public mainnet market-data endpoints.
# HYPERLIQUID_REST_BASE_URL=https://api.hyperliquid.xyz
# HYPERLIQUID_STREAM_URL=wss://api.hyperliquid.xyz/ws

# Hyperliquid Testnet real-trading P0 guardrails. The server never accepts or stores an API-wallet private key.
# REAL_TRADING_EXCHANGE_RATE_LIMIT_MAX=30
# REAL_TRADING_RISK_MAX_LEVERAGE=20
# REAL_TRADING_RISK_MAX_ORDER_NOTIONAL_EQUITY_RATIO=0.5
# REAL_TRADING_RISK_MAX_TOTAL_NOTIONAL_EQUITY_RATIO=2
# REAL_TRADING_RISK_MAX_OPEN_ORDERS=20
# REAL_TRADING_RISK_MAX_SNAPSHOT_AGE_MS=10000
# REAL_TRADING_AUDIT_RETENTION_DAYS=180
# REAL_TRADING_REALTIME_TOKEN_TTL_MS=60000
# REAL_TRADING_REALTIME_MAX_ADDRESSES=100
# Pending reconciliation worker only queries Hyperliquid orderStatus; it never replays signed orders.
# REAL_TRADING_RECONCILIATION_INTERVAL_MS=60000
# REAL_TRADING_RECONCILIATION_BATCH_SIZE=50

# Optional SQLite file path for simulated accounts, orders, positions, and balance adjustments.
# Defaults to server/data/trading.sqlite
# TRADING_DB_PATH=server/data/trading.sqlite

# Strategy Paper reports. Production Compose pins these to /app/strategy-data on a dedicated named volume.
# STRATEGY_FORWARD_REPORT_PATH=server/data/strategy/research-ict-route-b-forward.json
# STRATEGY_HISTORY_REPORT_PATH=server/data/strategy/research-ict-route-b-history.json
# STRATEGY_FORWARD_WORKER_ENABLED=true
# STRATEGY_FORWARD_WORKER_POLL_MS=300000
# MARTINGALE_GRID_PAPER_REPORT_PATH=server/data/strategy/research-martingale-grid-paper.json
# MARTINGALE_GRID_PAPER_WORKER_ENABLED=true
# MARTINGALE_GRID_PAPER_WORKER_POLL_MS=300000
# FIXED_GRID_PAPER_REPORT_PATH=server/data/strategy/research-fixed-grid-paper.json
# FIXED_GRID_ARCHIVE_CACHE_PATH=server/data/strategy/fixed-grid-archive-cache
# FIXED_GRID_PAPER_WORKER_ENABLED=true
# FIXED_GRID_PAPER_WORKER_POLL_MS=300000
# Strategy alert email is disabled by default; enable only after SMTP is configured.
# STRATEGY_EMAIL_ALERTS_ENABLED=false
# STRATEGY_ALERT_EMAIL_TO=ops@example.invalid
# STRATEGY_ALERT_COOLDOWN_MS=900000

# BSC Testnet only. Keep the private key and mnemonic in a secret manager in production.
# BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# BSC_TESTNET_CHAIN_ID=97
# BSC_TESTNET_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# BSC_TESTNET_TOKEN_DECIMALS=18
# BSC_TESTNET_CONFIRMATIONS=1
# BSC_TESTNET_SCAN_START_BLOCK=0
# BSC_TESTNET_SCAN_BATCH_SIZE=1
# BSC_TESTNET_PRIVATE_KEY=
# BSC_TESTNET_DEPOSIT_MNEMONIC=
# BSC_TESTNET_DERIVATION_PATH=m/44'/60'/0'/0
