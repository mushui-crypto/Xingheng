NODE_ENV=development
API_PORT=8787
GIT_COMMIT=development

# Personal Binance credential. Grant read, spot trade, and futures trade only; disable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Exact comma-separated public IPv4 values matching the Binance API key whitelist.
BINANCE_ALLOWED_EGRESS_IPS=

# Multi-user credential encryption. ADC or Workload Identity supplies KMS authentication.
# Runtime IAM only needs cloudkms.cryptoKeyVersions.useToEncrypt/useToDecrypt.
GCP_KMS_CREDENTIAL_KEY_NAME=
USER_CREDENTIAL_ENVIRONMENT=development

# Binance new-risk trading is fail-closed unless both switches are explicitly configured.
LIVE_TRADING_ENABLED=false
BINANCE_KILL_SWITCH=true
# OKX mutation requires its own explicit live switch and inactive kill switch.
OKX_LIVE_TRADING_ENABLED=false
OKX_KILL_SWITCH=true
# Bybit mutation is independently fail-closed.
BYBIT_LIVE_TRADING_ENABLED=false
BYBIT_KILL_SWITCH=true
# Bitget mutation is independently fail-closed.
BITGET_LIVE_TRADING_ENABLED=false
BITGET_KILL_SWITCH=true
MAX_ORDER_USD=25
MAX_POSITION_USD=100
BINANCE_MAX_ENTRY_BASIS_BPS=30
BINANCE_MIN_NET_APR_PERCENT=8
BINANCE_MAX_SLIPPAGE_BPS=20
BINANCE_ORDER_TIMEOUT_MS=10000
BINANCE_PROCESSING_TIMEOUT_MS=60000

# Optional SQLite paths.
TRADING_DB_PATH=server/data/trading.sqlite
BINANCE_TRADING_DB_PATH=server/data/binance-personal.sqlite
BINANCE_USER_ORDER_DB_DIR=server/data/binance-users

# Existing application authentication and networking.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-long-random-secret
# USER_SESSION_TTL_HOURS=24
# ADMIN_SESSION_TTL_HOURS=8
# AUTH_RATE_LIMIT_MAX=10
# CORS_ALLOWED_ORIGINS=https://your-domain.example
# APP_PUBLIC_URL=http://localhost:5173
# TRUST_PROXY=false

