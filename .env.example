API_PORT=8787

# Binance native USDT-M futures endpoints for PERP BTC/USDT.
# BINANCE_REST_BASE_URL=https://fapi.binance.com
# BINANCE_KLINE_PATH=/fapi/v1/klines
# BINANCE_STREAM_BASE_URL=wss://fstream.binance.com/stream

# Optional SQLite file path for simulated accounts, orders, positions, and balance adjustments.
# Defaults to server/data/trading.sqlite
# TRADING_DB_PATH=server/data/trading.sqlite

# BNB Chain Testnet wallet settings for onchain deposit/withdraw testing.
# Recommended chain id: 97
# BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# BSC_TESTNET_PRIVATE_KEY=replace_with_testnet_hot_wallet_private_key

# Optional defaults for deploying a custom ERC-20 test token.
# BSC_TESTNET_TOKEN_NAME=StellarX Test USD
# BSC_TESTNET_TOKEN_SYMBOL=sUSDT
# BSC_TESTNET_TOKEN_DECIMALS=18

# Filled after deployment.
# BSC_TESTNET_TOKEN_ADDRESS=0xYourDeployedTokenAddress

# Dedicated mnemonic for deriving per-user deposit addresses on BSC testnet.
# Do not reuse the hot wallet private key or mnemonic.
# BSC_TESTNET_DEPOSIT_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
# BSC_TESTNET_DERIVATION_PATH=m/44'/60'/0'/0

# Start block for token transfer scanning.
# BSC_TESTNET_SCAN_START_BLOCK=0
