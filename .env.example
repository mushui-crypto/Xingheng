# REAL_TRADING_REALTIME_MAX_ADDRESSES=100
# REAL_TRADING_RECONCILIATION_INTERVAL_MS=60000
# REAL_TRADING_RECONCILIATION_BATCH_SIZE=50

# Existing paper strategy reports.
# STRATEGY_FORWARD_REPORT_PATH=server/data/strategy/research-ict-route-b-forward.json
# STRATEGY_HISTORY_REPORT_PATH=server/data/strategy/research-ict-route-b-history.json
# STRATEGY_FORWARD_WORKER_ENABLED=true
# MARTINGALE_GRID_PAPER_REPORT_PATH=server/data/strategy/research-martingale-grid-paper.json
